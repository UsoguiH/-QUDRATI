{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.qudrati.xyz"
        }
      ],
      "destination": "https://qudrati.xyz/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "qudrati-lime.vercel.app"
        }
      ],
      "destination": "https://qudrati.xyz/:path*",
      "statusCode": 308
    }
  ]
}
